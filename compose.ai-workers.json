{
  "name": "growwithus-ai-workers",
  "services": {
    "ollama": {
      "image": "ollama/ollama:latest",
      "environment": {
        "OLLAMA_HOST": "127.0.0.1:11434",
        "OLLAMA_NO_CLOUD": "1",
        "OLLAMA_NUM_PARALLEL": "1",
        "OLLAMA_MAX_LOADED_MODELS": "1",
        "OLLAMA_CONTEXT_LENGTH": "4096"
      },
      "volumes": [
        "ai-ollama:/root/.ollama"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "ollama",
          "list"
        ],
        "interval": "5s",
        "timeout": "5s",
        "retries": 30
      },
      "mem_limit": "4g",
      "restart": "unless-stopped",
      "network_mode": "host"
    },
    "ollama-init": {
      "image": "ollama/ollama:latest",
      "network_mode": "host",
      "environment": {
        "OLLAMA_HOST": "127.0.0.1:11434",
        "OLLAMA_NO_CLOUD": "1"
      },
      "entrypoint": [
        "ollama",
        "pull",
        "qwen2.5:3b"
      ],
      "depends_on": {
        "ollama": {
          "condition": "service_healthy"
        }
      },
      "restart": "no"
    },
    "whisper-init": {
      "build": {
        "context": "./local-ai"
      },
      "entrypoint": [
        "python",
        "download_model.py",
        "--model",
        "base",
        "--output",
        "/models/base"
      ],
      "volumes": [
        "ai-whisper:/models"
      ],
      "restart": "no"
    },
    "stt": {
      "build": {
        "context": "./local-ai"
      },
      "network_mode": "host",
      "environment": {
        "WHISPER_MODEL_PATH": "/models/base",
        "HF_HUB_OFFLINE": "1",
        "OMP_NUM_THREADS": "4"
      },
      "volumes": [
        "ai-whisper:/models:ro"
      ],
      "depends_on": {
        "ollama": {
          "condition": "service_healthy"
        },
        "whisper-init": {
          "condition": "service_completed_successfully"
        }
      },
      "healthcheck": {
        "test": [
          "CMD",
          "python",
          "-c",
          "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8765/health', timeout=3)"
        ],
        "interval": "5s",
        "timeout": "5s",
        "start_period": "90s",
        "retries": 20
      },
      "mem_limit": "2g",
      "restart": "unless-stopped"
    }
  },
  "volumes": {
    "ai-ollama": {},
    "ai-whisper": {}
  }
}
