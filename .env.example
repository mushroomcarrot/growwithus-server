# 이 파일을 .env로 복사해서 값을 채운다. .env는 git에 올리지 않는다.
# application.yml의 spring.config.import가 .env를 읽으므로 로컬 실행 시 자동으로 반영된다.

# local 또는 prod
SPRING_PROFILES_ACTIVE=local

# MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_NAME=growwithus-server
DB_USERNAME=root
DB_PASSWORD=root

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT: Base64 인코딩된 256비트 이상. 생성 예시: openssl rand -base64 32
# 주석 상태로 두면 local 프로필은 개발용 더미 키를 쓴다. 빈 값(JWT_SECRET_KEY=)으로 두면 부팅이 실패하니 주석을 풀 때는 반드시 값을 채운다.
# prod에서는 반드시 설정한다.
# JWT_SECRET_KEY=
# 만료 시간 (ms). 기본값: Access 1시간, Refresh 7일
JWT_ACCESS_TOKEN_EXPIRE_TIME=3600000
JWT_REFRESH_TOKEN_EXPIRE_TIME=604800000

# 콤마로 구분한 허용 Origin 패턴
CORS_ALLOWED_ORIGINS=*

# 내부 배치 API(/internal/**)의 X-Service-Key 헤더 값. 생성 예시: openssl rand -hex 32
# 주석 상태로 두면 local 프로필은 개발용 키(local-internal-service-key)를 쓴다. prod에서는 반드시 설정한다.
# INTERNAL_SERVICE_KEY=

# 시연 API(/demo/**) 사용 여부. true여도 ADMIN 토큰과 X-Demo-Mode 헤더가 모두 있어야 한다. false면 모두 거부한다
DEMO_ENABLED=true
# 시연 계정(minji, soonja)의 비밀번호. 8자 이상으로 넣으면 부팅할 때 시연 계정과 텃밭(B-14)을 만든다. 주석 상태면 만들지 않는다
# DEMO_SEED_PASSWORD=

# 스케줄러(@Scheduled) 사용 여부. false면 배치는 /internal API로만 실행된다
SCHEDULER_ENABLED=true

# 파일 업로드: 저장소 종류(local), 저장 폴더, 업로드 URL 앞에 붙는 서버 주소
FILE_STORAGE=local
FILE_UPLOAD_DIR=./uploads
FILE_BASE_URL=http://localhost:8080

# 외부 API 호출 타임아웃
EXTERNAL_HTTP_CONNECT_TIMEOUT=3s
# 음성 처리 유효 시간은 읽기 제한의 2배 + 30초이며 최소 2분이다.
EXTERNAL_HTTP_READ_TIMEOUT=30s

# 공공데이터포털 인증키 (기상청 단기예보 조회서비스). 포털 마이페이지의 "일반 인증키"를 그대로 넣는다 (docs/public-data.md)
# 주석 상태로 두면 날씨 수집을 건너뛴다. 빈 값(PUBLIC_DATA_SERVICE_KEY=)으로 두어도 같다.
# PUBLIC_DATA_SERVICE_KEY=
# 기상청 호출 실패 시 전체 시도 횟수와 다시 시도하기 전 대기 시간
KMA_MAX_ATTEMPTS=3
KMA_RETRY_DELAY=1s
# 농장 도메인이 붙기 전까지 날씨를 수집할 기상청 격자. nx:ny를 콤마로 잇는다 (기본값은 용인시 처인구 대표 격자)
WEATHER_DEFAULT_GRIDS=64:119

# LLM, STT, TTS 외부 제공자용 예약 설정. 실제 연결에는 제공자 구현이 필요하다.
# 아래 외부 제공자 항목은 키만 넣으면 연결되지 않으며 제공자 구현이 필요하다.
# 현재 구현된 STT와 LLM은 아래 AI_LOCAL 설정을 사용한다.
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=
# STT_API_KEY=
# STT_BASE_URL=
# STT_MODEL=
# TTS_API_KEY=
# TTS_BASE_URL=
# TTS_MODEL=
# TTS_VOICE=
# 추가 요금 없는 로컬 Ollama. 설치 및 모델 다운로드는 별도로 필요하다.
# Ollama 서버는 OLLAMA_NO_CLOUD=1로 실행하고 다운로드된 로컬 모델만 지정한다.
AI_LOCAL_ENABLED=false
AI_LOCAL_BASE_URL=http://127.0.0.1:11434
AI_LOCAL_MODEL=
AI_LOCAL_VISION_MODEL=
AI_LOCAL_STT_ENABLED=false
AI_LOCAL_STT_BASE_URL=http://127.0.0.1:8765
CARE_ALLOWANCE_PER_TASK=0
# Optional offline Korean TTS worker. Enable only after the worker is running.
AI_LOCAL_TTS_ENABLED=false
AI_LOCAL_TTS_BASE_URL=http://127.0.0.1:8766

# 시연 방문 예약 시드. 시연 농장의 기존 텃밭이 있을 때만 동작
DEMO_SEED_VISIT_ENABLED=false
# Small-server cloud AI. Use a Free tier project without Cloud Billing.
AI_GEMINI_ENABLED=false
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# 관리사 AI 아바타용 이미지 모델 (예: gemini-3.1-flash-image). 비워 두면 생성하지 않고 기본 아바타를 쓴다.
GEMINI_IMAGE_MODEL=

# 자연스러운 한국어 TTS. 기존 ElevenLabs 크레딧을 사용하며 별도 결제 설정은 변경하지 않는다.
AI_ELEVENLABS_ENABLED=false
# ELEVENLABS_API_KEY=
# ElevenLabs 계정에서 사용 가능한 한국어 목소리의 20자리 ID
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
