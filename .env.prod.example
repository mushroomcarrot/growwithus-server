# Existing team server. Replace every CHANGE_ME value before use.
# The application imports .env, or equivalent process environment variables.
SPRING_PROFILES_ACTIVE=prod
DB_HOST=CHANGE_ME
DB_PORT=3306
DB_NAME=CHANGE_ME
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME
REDIS_HOST=CHANGE_ME
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
# Generate separate real secrets. Never commit the populated .env.
JWT_SECRET_KEY=CHANGE_ME_BASE64_SECRET
INTERNAL_SERVICE_KEY=CHANGE_ME_SEPARATE_SECRET
CORS_ALLOWED_ORIGINS=https://CHANGE_ME_FRONTEND_HOST
DEMO_ENABLED=false
SCHEDULER_ENABLED=true
FILE_STORAGE=local
FILE_UPLOAD_DIR=/app/uploads
FILE_BASE_URL=https://CHANGE_ME_BACKEND_HOST
EXTERNAL_HTTP_CONNECT_TIMEOUT=3s
EXTERNAL_HTTP_READ_TIMEOUT=90s
# Requires workers in the SAME network namespace as Spring.
# Separate containers do not share 127.0.0.1 by default.
AI_LOCAL_ENABLED=true
AI_LOCAL_BASE_URL=http://127.0.0.1:11434
AI_LOCAL_MODEL=qwen2.5:3b
AI_LOCAL_VISION_MODEL=
AI_LOCAL_STT_ENABLED=true
AI_LOCAL_STT_BASE_URL=http://127.0.0.1:8765
CARE_ALLOWANCE_PER_TASK=0
