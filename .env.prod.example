# 서버의 ~/growwithus-server/.env로 복사해 CHANGE_ME를 모두 채운다. 채운 파일은 커밋하지 않는다.
# docker-compose.yml이 이 파일을 app 컨테이너 환경변수로 넣고, deploy.yml이 APP_IMAGE를 배포마다 바꾼다.
APP_IMAGE=ghcr.io/mushroomcarrot/growwithus-server:<commit-sha>
SPRING_PROFILES_ACTIVE=prod
TZ=Asia/Seoul

# 새 DB에 처음 배포할 때만 update로 테이블을 만든다. 첫 배포가 끝나면 validate로 되돌린다.
JPA_DDL_AUTO=update

# compose의 mariadb, redis 컨테이너. 비밀번호가 비어 있으면 compose가 실행을 거부한다.
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=growwithus_server
DB_USERNAME=growwithus_server
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# 서로 다른 실제 값으로 만든다. 생성 예시: openssl rand -base64 32, openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_BASE64_SECRET
INTERNAL_SERVICE_KEY=CHANGE_ME_SEPARATE_SECRET
JWT_ACCESS_TOKEN_EXPIRE_TIME=3600000
JWT_REFRESH_TOKEN_EXPIRE_TIME=604800000

CORS_ALLOWED_ORIGINS=https://CHANGE_ME_FRONTEND_HOST
DEMO_ENABLED=false
SCHEDULER_ENABLED=true

# 업로드 파일은 compose의 uploads 볼륨(/app/uploads)에 남는다.
FILE_STORAGE=local
FILE_UPLOAD_DIR=/app/uploads
FILE_BASE_URL=https://grow-api.yuns.kr

EXTERNAL_HTTP_CONNECT_TIMEOUT=3s
EXTERNAL_HTTP_READ_TIMEOUT=90s

# 공공데이터포털 일반 인증키 (기상청 단기예보). 비워 두면 날씨 수집을 건너뛴다.
PUBLIC_DATA_SERVICE_KEY=CHANGE_ME
KMA_MAX_ATTEMPTS=3
KMA_RETRY_DELAY=1s
WEATHER_DEFAULT_GRIDS=64:119

# 로컬 AI 클라이언트는 loopback 주소만 허용한다. compose의 app 컨테이너에서는 호스트의
# compose.ai-workers.json 작업자(127.0.0.1)에 닿지 않으므로 이 구성에서는 끈다.
AI_LOCAL_ENABLED=false
AI_LOCAL_BASE_URL=http://127.0.0.1:11434
AI_LOCAL_MODEL=qwen2.5:3b
AI_LOCAL_STT_ENABLED=false
AI_LOCAL_STT_BASE_URL=http://127.0.0.1:8765
CARE_ALLOWANCE_PER_TASK=0

# Offline Korean eSpeak NG. Start the tts worker before enabling.
AI_LOCAL_TTS_ENABLED=false
AI_LOCAL_TTS_BASE_URL=http://127.0.0.1:8766
# 2 CPU / 2 GB: no Ollama, Whisper or separate TTS worker needed.
# Supply a Free tier Gemini key from a project WITHOUT Cloud Billing.
AI_GEMINI_ENABLED=true
GEMINI_API_KEY=CHANGE_ME_FREE_TIER_KEY
GEMINI_MODEL=gemini-3.5-flash-lite
# 관리사 AI 아바타용 이미지 모델 (예: gemini-3.1-flash-image). 비워 두면 생성하지 않고 기본 아바타를 쓴다.
GEMINI_IMAGE_MODEL=

# ElevenLabs 한국어 TTS. 키와 목소리 설정 후에만 활성화한다. 기존 크레딧 사용, 초과 과금은 계정에서 끈다.
AI_ELEVENLABS_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
